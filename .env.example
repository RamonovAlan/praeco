# Copy this file to .env and fill it locally. Never commit .env.
PRAECO_ENV=development
PRAECO_OWNER_TELEGRAM_USER_ID=
PRAECO_TELEGRAM_BOT_TOKEN=
PRAECO_DATABASE_PATH=./data/praeco.sqlite3
PRAECO_MEDIA_DIR=./media
PRAECO_PUBLIC_BASE_URL=
PRAECO_PROVIDER_MODE=mock
# Omit migration/prompt/style paths to use source-tree or packaged defaults.
PRAECO_HEALTH_HOST=127.0.0.1
PRAECO_HEALTH_PORT=8080
PRAECO_POLLING_TIMEOUT_SECONDS=30
PRAECO_IDLE_SLEEP_SECONDS=1
PRAECO_RETRY_SECONDS=5

# Required only when PRAECO_PROVIDER_MODE=openai.
PRAECO_AI_API_KEY=
PRAECO_LINKEDIN_CLIENT_ID=
PRAECO_LINKEDIN_CLIENT_SECRET=
PRAECO_LINKEDIN_REDIRECT_URI=
PRAECO_LINKEDIN_API_VERSION=
PRAECO_CREDENTIAL_ENCRYPTION_KEY=

# Publishing is disabled by default.
PRAECO_PUBLISHING_ENABLED=false
PRAECO_PER_POST_WARNING_USD=0.50
PRAECO_PER_POST_HARD_LIMIT_USD=0.75
PRAECO_MONTHLY_BUDGET_USD=25

# Economy defaults: one requested output and no automatic paid retry.
PRAECO_TEXT_DRAFTS_PER_REQUEST=1
PRAECO_IMAGE_OUTPUTS_PER_REQUEST=1
PRAECO_AUTOMATIC_PAID_RETRY_LIMIT=0
